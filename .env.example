# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# Chat ID мастера (администратора). Узнать можно у @userinfobot
ADMIN_CHAT_ID=123456789

# ID Google-таблицы (из URL: docs.google.com/spreadsheets/d/ЭТОТ_ID/edit)
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Данные сервисного аккаунта Google (из скачанного JSON-ключа)
GOOGLE_SERVICE_ACCOUNT_EMAIL=makeup-bot@your-project.iam.gserviceaccount.com
# Приватный ключ. Сохраняйте переносы строк как \n (одна строка в .env)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# За сколько часов до визита слать напоминание клиенту
REMINDER_HOURS_BEFORE=24

# Секрет для защиты /reminders/run от чужих запросов (придумайте свою строку)
CRON_SECRET=change-me-to-random-string

# Публичный URL сервиса после деплоя (нужен для режима webhook), например:
# https://makeup-booking-bot.onrender.com
PUBLIC_URL=

# Порт (Render подставляет свой автоматически через process.env.PORT)
PORT=3000
