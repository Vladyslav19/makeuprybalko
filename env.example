# Токен бота від @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# Chat ID майстра (адміністратора). Дізнатися можна у @userinfobot
ADMIN_CHAT_ID=123456789

# ID Google-таблиці (з URL: docs.google.com/spreadsheets/d/ЦЕЙ_ID/edit)
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Дані сервісного акаунта Google (зі скачаного JSON-ключа)
GOOGLE_SERVICE_ACCOUNT_EMAIL=makeup-bot@your-project.iam.gserviceaccount.com
# Приватний ключ. Зберігайте переноси рядків як \n (один рядок у .env)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# За скільки годин до візиту слати нагадування клієнту
REMINDER_HOURS_BEFORE=24

# Крок сітки слотів у хвилинах. Усі слоти (/addslot, /addslots) мають бути
# кратні цьому кроку — так бот зможе бронювати кілька слотів підряд під
# послуги тривалістю 90/120/180 хв тощо.
SLOT_INTERVAL_MINUTES=30

# Секрет для захисту /reminders/run від чужих запитів (придумайте свій рядок)
CRON_SECRET=change-me-to-random-string

# Публічний URL сервісу після деплою (потрібен для режиму webhook), наприклад:
# https://makeup-booking-bot.onrender.com
PUBLIC_URL=

# Порт (Render підставляє свій автоматично через process.env.PORT)
PORT=3000
